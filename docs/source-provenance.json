    {
      "source_path": "btc_envelope_maker/btc_envelope_maker.py",
      "destination_path": "btc_envelope_maker/btc_envelope_maker.py",
      "source_sha256": "ba28920c681daf903730c294ac510dde5deb111c7262a8534fe6bfde46bbb37e",
